{
  "name": "aquachile-api",
  "version": "1.0.0",
  "description": "API REST backend para el módulo de evaluaciones psicolaborales AquaChile (DSY1104)",
  "type": "commonjs",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/servidor.js",
    "dev": "node --env-file-if-exists=.env --watch src/servidor.js",
    "db:migrar": "node src/bd/migrar.js",
    "db:semilla": "node src/bd/semilla.js",
    "test": "node src/probar_api.js",
    "test:almacenamiento": "node --test src/almacenamiento/almacenamiento.test.js",
    "test:auth": "node --test src/middlewares/auth.test.js",
    "test:roles": "node --test src/roles.test.js",
    "test:integracion": "node --test src/integracion.test.js",
    "drive:autorizar": "node --env-file-if-exists=.env src/almacenamiento/autorizarDrive.js"
  },
  "keywords": [
    "aquachile",
    "api",
    "express",
    "sqlite",
    "evaluaciones"
  ],
  "author": "AquaChile - Reclutamiento y Selección",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2"
  }
}
