# Copia este archivo como .env y ajusta los valores.
# Uso: node --env-file=.env src/servidor.js

PORT=3001

# Obligatorio en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGENES=http://localhost:5173

# Ruta del archivo SQLite (opcional)
# AQUACHILE_BD=./datos.sqlite

# NODE_ENV=production
