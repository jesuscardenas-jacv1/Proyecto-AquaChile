# Copie este archivo como .env y complete los valores.

# Clave para firmar las sesiones (JWT). Obligatoria en producción, mínimo 32 caracteres.
# Genere una propia con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=

# Proveedor de documentos: "local" (carpeta en disco), "drive" (Google Drive) o "graph" (OneDrive / SharePoint)
ALMACENAMIENTO=local

# --- Proveedor local ---
# Carpeta donde se crean las carpetas de cada solicitud (por defecto backend/documentos)
# ALMACENAMIENTO_LOCAL_RUTA=./documentos

# --- Proveedor Microsoft Graph ---
# Registro de aplicación en Microsoft Entra ID (permiso de aplicación Sites.Selected
# o Files.ReadWrite.All, con consentimiento de un administrador del tenant)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Destino: una biblioteca de SharePoint (recomendado) ...
GRAPH_DRIVE_ID=
# ... o el OneDrive de una cuenta de servicio (si no se define GRAPH_DRIVE_ID)
GRAPH_USUARIO=
# Carpeta raíz dentro del destino; se crea si no existe
GRAPH_CARPETA_RAIZ=Evaluaciones Psicolaborales

# --- Proveedor Google Drive (ALMACENAMIENTO=drive) ---
# Modo "oauth" (recomendado, sirve con cualquier cuenta de Google):
#   1. En Google Cloud Console habilite la "Google Drive API" y cree un cliente OAuth
#      de tipo "Aplicación de escritorio".
#   2. Copie aquí su ID y secreto y ejecute: npm run drive:autorizar
#   3. El refresh token queda en backend/.gdrive-token.json (no se versiona).
# Modo "cuenta-servicio": solo con una unidad compartida de Google Workspace; defina
#   GDRIVE_CREDENCIALES (ruta a la llave JSON) y GDRIVE_CARPETA_RAIZ_ID.
GDRIVE_MODO=oauth
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# GDRIVE_TOKEN_ARCHIVO=./.gdrive-token.json
# GDRIVE_CREDENCIALES=./credenciales-drive.json
# Carpeta raíz: un ID de carpeta existente o, en modo oauth, un nombre que se crea en "Mi unidad"
# GDRIVE_CARPETA_RAIZ_ID=
GDRIVE_CARPETA_RAIZ=Evaluaciones Psicolaborales

# --- Reuniones online de la entrevista (Planner) ---
# Google Meet: usa el cliente OAuth y la cuenta de Google Drive de arriba, con el alcance
# calendar.events. Habilite la "Google Calendar API" en el mismo proyecto y vuelva a ejecutar
# npm run drive:autorizar (pide Drive y Calendar). Sin ese permiso la entrevista se agenda igual, con un aviso.
# REUNIONES_GOOGLE=no                      # desactiva la creación de eventos con Meet
# REUNIONES_CALENDARIO_ID=primary          # calendario de la cuenta donde se crean los eventos
# Teams: por defecto la psicóloga pega el enlace. Con "graph" se crea con Microsoft Graph usando
# GRAPH_TENANT_ID, GRAPH_CLIENT_ID y GRAPH_CLIENT_SECRET (permiso de aplicación Calendars.ReadWrite
# aprobado por un administrador del tenant; ver backend/README.md).
# REUNIONES_TEAMS=graph
# GRAPH_REUNIONES_USUARIO=reclutamiento@empresa.cl   # buzón que organiza las reuniones de Teams

# --- Producción (Azure App Service) ---
# NODE_ENV=production                      # exige JWT_SECRETO
# BD_RUTA=/home/data/datos.sqlite          # BD en el disco persistente de App Service
# SEMILLA_DATOS=/home/site/wwwroot/datos-semilla
# CORS_ORIGENES=https://jesuscardenas-jacv1.github.io
# GDRIVE_REFRESH_TOKEN=                    # en el servidor reemplaza al archivo .gdrive-token.json (Drive + Calendar)


# --- IA (Claude, de Anthropic) ---
# Sin clave, las ayudas de IA (análisis de CV, autocompletar, redactar ofertas) quedan ocultas.
# La clave se crea en console.anthropic.com y nunca se sube al repositorio.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-opus-5-5
