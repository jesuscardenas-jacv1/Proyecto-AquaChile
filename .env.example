# Variables del FRONTEND (Vite). Copia este archivo como .env.local si necesitas cambiarlas.
# En desarrollo no hace falta ninguna: /api se redirige al backend en http://localhost:3001.

# URL de la API cuando el frontend se publica en un servidor distinto al del backend
# VITE_API_URL=https://mi-backend.ejemplo.cl/api

# Modo demo: datos en el navegador y login local, sin backend (lo usa GitHub Pages)
# VITE_MODO_DEMO=true

# Solo para `npm run dev`: a dónde redirige Vite las peticiones /api
# API_PROXY_DESTINO=http://localhost:3001
